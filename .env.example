# Frontend Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional NestJS server configuration
PORT=3001
EXCHANGE_RATES_ENDPOINT=

# Server-side recurring payment worker and authenticated PDF reports
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# The PDF report endpoint uses the server-only key to verify the caller and read only
# that caller's transactions. Never expose SUPABASE_SERVICE_ROLE_KEY in the browser.
