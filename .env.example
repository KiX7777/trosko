# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional Next.js API route configuration
EXCHANGE_RATES_ENDPOINT=
OCR_LANG_PATH=
# Random string with at least 16 characters; configure the same value in Vercel Production.
CRON_SECRET=replace-with-a-random-secret

# Server-only credentials used by /api/recurring/process
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
